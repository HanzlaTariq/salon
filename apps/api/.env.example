# Copy to .env for local development. NEVER commit .env or real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# App connects as the least-privilege role (RLS enforced). Migrations use MIGRATION_DATABASE_URL.
DATABASE_URL=postgresql://salon_app:salon_app_dev_pw@localhost:5432/salon?schema=public
MIGRATION_DATABASE_URL=postgresql://salon_migrator:salon_migrator_dev_pw@localhost:5432/salon?schema=public

# Comma-separated strict allowlist. No wildcards.
CORS_ORIGINS=http://localhost:5173

# Rate limiting (global default; sensitive endpoints get stricter limits in later phases)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300

# Swagger UI: only honoured outside production
ENABLE_SWAGGER=true

# ---- Phase 2: authentication (NEVER commit real values) ----
# Number of reverse proxies in front of the API (0 locally). Needed for correct client IPs / rate limits.
TRUST_PROXY_HOPS=0
# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_dev_only_secret_at_least_32_characters_long
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_DAYS=90
# true in production (HTTPS only)
COOKIE_SECURE=false
# Public URL of the web app hosting /verify-email and /reset-password
WEB_APP_URL=http://localhost:5173
# base64 of exactly 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=CHANGE_ME_generate_32_random_bytes_base64
REQUIRE_ADMIN_MFA=true
# Argon2id (OWASP minimum: m=19456 KiB, t=2, p=1). Raise on stronger servers.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# console = prints nothing sensitive, dev only. Production must use smtp.
MAIL_TRANSPORT=console
MAIL_FROM="Salon Platform <no-reply@localhost>"
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_SECURE=false
