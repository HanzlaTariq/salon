# Copy to .env for local development. NEVER commit .env or real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---- Database: SUPABASE (managed PostgreSQL) ----
# Supabase Dashboard > Connect. Replace [REF] (project ref), [REGION], passwords.
#
# DATABASE_URL = runtime. Supavisor pooler, TRANSACTION mode (port 6543), as the least-privilege
#   `salon_app` role (created by infra/supabase/01-roles.sql). RLS is enforced for this role.
#   Pooler usernames look like  salon_app.[REF]   (role name + "." + project ref).
#   `pgbouncer=true` is REQUIRED for Prisma with the transaction pooler.
DATABASE_URL=postgresql://salon_app.[REF]:[SALON_APP_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require
#
# DIRECT_URL = prisma migrate / db commands only. Direct connection (db.[REF].supabase.co:5432) if your
#   network has IPv6, otherwise the pooler SESSION mode (port 5432):
#   postgresql://postgres.[REF]:[POSTGRES_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.[REF]:[POSTGRES_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# ---- Local docker Postgres instead of Supabase (optional) ----
# DATABASE_URL=postgresql://salon_app:salon_app_dev_pw@localhost:5432/salon?schema=public
# DIRECT_URL=postgresql://salon_migrator:salon_migrator_dev_pw@localhost:5432/salon?schema=public

# Comma-separated strict allowlist. No wildcards.
CORS_ORIGINS=http://localhost:5173

# Rate limiting (global default; sensitive endpoints get stricter limits in later phases)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300

# Swagger UI: only honoured outside production
ENABLE_SWAGGER=true

# ---- Phase 2: authentication (NEVER commit real values) ----
# Number of reverse proxies in front of the API (0 locally). Needed for correct client IPs / rate limits.
TRUST_PROXY_HOPS=0
# >= 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_dev_only_secret_at_least_32_characters_long
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_DAYS=90
# true in production (HTTPS only)
COOKIE_SECURE=false
# Public URL of the web app hosting /verify-email and /reset-password
WEB_APP_URL=http://localhost:5173
# base64 of exactly 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=CHANGE_ME_generate_32_random_bytes_base64
REQUIRE_ADMIN_MFA=true
# Argon2id (OWASP minimum: m=19456 KiB, t=2, p=1). Raise on stronger servers.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# console = prints nothing sensitive, dev only. Production must use smtp.
MAIL_TRANSPORT=console
MAIL_FROM="Salon Platform <no-reply@localhost>"
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_SECURE=false

# ---- Phase 2b: shared rate limits + breached-password check ----
# Redis (docker-compose: redis://localhost:6379). REQUIRED in production. Unset = in-memory (dev/tests only).
#REDIS_URL=redis://localhost:6379
# Breached-password check (HIBP k-anonymity: only 5 hash chars leave the server). Tests disable it.
HIBP_CHECK_ENABLED=true
# true = refuse a password when HIBP cannot be reached (stricter, less available). Default false.
HIBP_FAIL_CLOSED=false

# ---- Phase 3: private file storage for salon documents and photos ----
# memory = tests/local dev only (files vanish on restart; refused in production).
STORAGE_DRIVER=memory
# For STORAGE_DRIVER=supabase (backend ONLY; never in Flutter/admin-web/git/logs):
#SUPABASE_URL=https://<project-ref>.supabase.co
# Dashboard > Project Settings > API Keys > service_role (secret). Rotate it if it ever leaks.
#SUPABASE_SERVICE_ROLE_KEY=
# Create this bucket in Dashboard > Storage with "Public bucket" turned OFF.
#SUPABASE_STORAGE_BUCKET=salon-private
# Per-file cap in bytes (max 10485760) and signed-URL lifetime in seconds.
UPLOAD_MAX_BYTES=5242880
SIGNED_URL_TTL_SEC=300

