// Phase 10: notifications (push + in-app history).
// Hand-written SQL in migrations/20261117000000_notifications_phase10 is the source of truth for CHECK constraints, triggers
// (the outbox is fed by database triggers), RLS policies and grants. These models mirror the columns for typed access; all Phase 10
// queries are parameterized $queryRaw in notification.repository.ts.

/// Transactional outbox: one row per fact worth telling someone about (ids only, never names or message text).
model NotificationEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// BOOKING_CREATED | BOOKING_CANCELLED | ... | STAFF_SCHEDULE (CHECK).
  kind        String    @db.VarChar(24)
  salonId     String?   @map("salon_id") @db.Uuid
  /// HISTORY | APPOINTMENT | SALON | PAYMENT | SUBSCRIPTION | INVITATION | STAFF (CHECK).
  refType     String    @map("ref_type") @db.VarChar(12)
  refId       String    @map("ref_id") @db.Uuid
  /// Whoever caused the fact. Never notified about their own action.
  actorUserId String?   @map("actor_user_id") @db.Uuid
  payload     Json      @default("{}")
  dedupeKey   String    @unique @map("dedupe_key") @db.VarChar(140)
  /// PENDING | DONE | DEAD (CHECK).
  status      String    @default("PENDING") @db.VarChar(8)
  attempts    Int       @default(0) @db.SmallInt
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(6)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)
  lastError   String?   @map("last_error") @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@map("notification_events")
}

/// The in-app history. Only `readAt` can change (trigger).
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  salonId   String?   @map("salon_id") @db.Uuid
  eventId   String?   @map("event_id") @db.Uuid
  type      String    @db.VarChar(40)
  /// BOOKINGS | REMINDERS | QUEUE | TEAM | ACCOUNT (CHECK).
  category  String    @db.VarChar(10)
  title     String    @db.VarChar(120)
  body      String    @db.VarChar(300)
  data      Json      @default("{}")
  locale    String    @default("en") @db.VarChar(2)
  dedupeKey String    @map("dedupe_key") @db.VarChar(140)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  @@unique([userId, dedupeKey], map: "notifications_user_dedupe")
  @@map("notifications")
}

model DeviceToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  sessionId      String?   @map("session_id") @db.Uuid
  token          String
  /// SHA-256 hex of the token (unique). The token itself is never logged.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  /// ANDROID | IOS (CHECK).
  platform       String    @db.VarChar(7)
  /// CUSTOMER | BUSINESS (CHECK).
  app            String    @db.VarChar(8)
  appVersion     String?   @map("app_version") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  disabledAt     DateTime? @map("disabled_at") @db.Timestamptz(6)
  disabledReason String?   @map("disabled_reason") @db.VarChar(20)

  @@map("device_tokens")
}

/// No row = the defaults in notification.types.ts.
model NotificationPreference {
  userId          String   @id @map("user_id") @db.Uuid
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  language        String   @default("en") @db.VarChar(2)
  bookings        Boolean  @default(true)
  reminders       Boolean  @default(true)
  queue           Boolean  @default(true)
  team            Boolean  @default(true)
  reminderOffsets Int[]    @default([30, 20, 10, 0]) @map("reminder_offsets") @db.SmallInt
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("notification_preferences")
}

model NotificationDelivery {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String    @map("notification_id") @db.Uuid
  deviceTokenId     String    @map("device_token_id") @db.Uuid
  /// PENDING | SENT | FAILED | INVALID_TOKEN (CHECK).
  status            String    @default("PENDING") @db.VarChar(13)
  attempts          Int       @default(0) @db.SmallInt
  lastError         String?   @map("last_error") @db.VarChar(120)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(200)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([notificationId, deviceTokenId], map: "notification_deliveries_unique")
  @@map("notification_deliveries")
}
