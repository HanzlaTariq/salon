# Compose-level settings (infra/deploy/.env). Copy to `.env`; it is git-ignored. NEVER commit real values.
# Two DNS A records must point to your server's public IPv4 BEFORE the first start (Caddy requests the certificates then).
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
# Let's Encrypt expiry warnings go here.
ACME_EMAIL=you@example.com
# URL-safe only (letters and digits). Generate: openssl rand -hex 24      PowerShell: -join ((1..48) | % { '{0:x}' -f (Get-Random -Max 16) })
REDIS_PASSWORD=
# Image tag, for example a git commit or a date. Lets you roll back by starting the previous tag.
RELEASE=latest
