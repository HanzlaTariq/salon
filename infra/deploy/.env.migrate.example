# Used ONLY by `docker compose run --rm migrate` (prisma migrate deploy). Copy to `.env.migrate`; it is git-ignored.
# This is the OWNER role (Supabase `postgres`) through the SESSION pooler, port 5432. It must never reach the API container.
# Both variables hold the same value (the Prisma schema reads both).
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
