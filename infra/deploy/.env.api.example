# API runtime environment (infra/deploy/.env.api). Copy to `.env.api`; it is git-ignored. NEVER commit real values.
# Check it before every deploy:   docker compose -f docker-compose.prod.yml run --rm cli npm run preflight
# REDIS_URL is added by docker-compose.prod.yml. Do NOT put DIRECT_URL or the `postgres` password in this file.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- Database: Supabase, TRANSACTION pooler (port 6543) as the least-privilege role created by infra/supabase/01-roles.sql
DATABASE_URL=postgresql://salon_app.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&sslmode=require

# ---- Web / CORS (https only). The admin panel calls /api on its own origin; CORS_ORIGINS must still list it.
CORS_ORIGINS=https://admin.example.com
WEB_APP_URL=https://admin.example.com
PUBLIC_LINK_BASE_URL=https://api.example.com
# One reverse proxy (Caddy) sits in front of the API.
TRUST_PROXY_HOPS=1
COOKIE_SECURE=true

# ---- Secrets. Generate each one separately.
# JWT_ACCESS_SECRET:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# MFA_ENCRYPTION_KEY (base64 of 32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# KEEP A COPY OFFLINE: without it every stored MFA secret is unreadable.
MFA_ENCRYPTION_KEY=
REQUIRE_ADMIN_MFA=true
HIBP_CHECK_ENABLED=true

# ---- Mail (required in production)
MAIL_TRANSPORT=smtp
MAIL_FROM="Salon Platform <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ---- Storage: Supabase Storage, PRIVATE bucket (Dashboard > Storage, "Public bucket" OFF). Service key is BACKEND ONLY.
STORAGE_DRIVER=supabase
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=salon-private

# ---- Push (Firebase Cloud Messaging). base64 of the service-account JSON.
PUSH_DRIVER=fcm
FCM_SERVICE_ACCOUNT_B64=
NOTIFICATIONS_WORKER_ENABLED=true

# ---- Housekeeping and monitoring
MAINTENANCE_WORKER_ENABLED=true
MAINTENANCE_DELETE_ORPHANS=false
# SENTRY_DSN=
APP_RELEASE=
# Store buttons on the QR landing page (fill in after the apps are published)
# APP_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=pk.salonplatform.customer
# APP_STORE_URL_IOS=https://apps.apple.com/app/id0000000000
BRAND_NAME="Salon Platform"
